<?xml version="1.0" encoding="utf-8"?>
<!--
  WHAT THIS FILE DOES NOT DO, FIRST, BECAUSE IT IS THE PART THAT WASTES DEBUGGING TIME:

  It does not govern this app's calls to a model server. Those go out through Dio, which
  on Android uses dart:io's HttpClient — raw sockets in the Dart VM, not the Java
  networking stack this file configures. So an Ollama or LM Studio box at a plain http://
  address on the LAN is reachable whether or not it appears below, and a connection that
  is failing is failing for some other reason. Look at the server's bind address
  (OLLAMA_HOST), the firewall, or the network, not here.

  What it does govern is plugin traffic that goes through Java or Kotlin — downloads and
  anything else a platform channel performs. Those are the requests these rules apply to.

  Android's <domain> matches a hostname or an IP literal exactly; there is no CIDR
  syntax, so a whole private range cannot be expressed here however much one would like
  to. "Allow 192.168.0.0/16" is not a thing this file can say. Each address has to be
  written out, which is why the list below is short and specific rather than a sweeping
  claim about private networks.

  Deliberately NOT android:usesCleartextTraffic="true" on <application>, and
  deliberately not cleartextTrafficPermitted="true" on <base-config>: either would permit
  plaintext to every host on the internet, which is a real loss for no gain the app needs.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />

    <domain-config cleartextTrafficPermitted="true">
        <!-- Loopback, and the Android emulator's alias for the host machine. -->
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>

        <!-- mDNS: a machine advertising itself as e.g. studio.local on the LAN. -->
        <domain includeSubdomains="true">local</domain>

        <!-- Tailscale MagicDNS. A tailnet name resolves to a 100.64.0.0/10 address that
             no LAN rule would cover, and unlike a numeric subnet the suffix IS
             expressible here, so a tailnet machine works by name without editing. -->
        <domain includeSubdomains="true">ts.net</domain>

        <!-- Add a server by numeric address here when a plugin needs to reach it over
             plaintext. One line per address; there is no range syntax.
             <domain includeSubdomains="false">192.168.1.50</domain> -->
    </domain-config>
</network-security-config>
